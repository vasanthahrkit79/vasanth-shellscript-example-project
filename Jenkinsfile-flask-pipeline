pipeline {
    agent any
    
    environment { 
        IMAGE_NAME = 'vasanthakumara79/python-flask'
        Docker_login_cred = credentials('Docker_password')
    }
        
    stages {
        stage('Pull Source Code') {
            steps {
                git changelog: false, poll: false, url: 'https://github.com/theshubhamgour/flask-portfolio.git'
            }
        }
        
        stage('Run Lint Test') {
            steps {
                // Installs flake8 globally on the agent and lints the code without failing the build
                sh 'pip3 install --break-system-packages flake8'
                sh 'flake8 . || true'
            }
        }
        
        stage('Docker Build') {
            steps {
                // Fixed: Changed 'docker run' to 'docker build'
                sh 'docker build -t $IMAGE_NAME:$BUILD_NUMBER .'
            }
        }
        stage('Docker push') {
            steps {
               sh 'docker login -u $Docker_login_cred_USR -p $Docker_login_cred_PSW '
               sh 'docker push $IMAGE_NAME:$BUILD_NUMBER'
            }
        }
    }
}
