pipeline {
    agent {
            label'slav-2'
       }

    stages {
        stage('Build') {
            steps {
            sh '''
              echo "system uptime is"
              uptime 
              date
            ''' 
            }
        }
        stage('Memory utilization by files and free memory') {
            steps {
              sh '''
                echo "memory utilization by files"
                df -kh
                du -h
              '''

            }
        }
        stage('CPU details') {
            steps {
             sh '''
                echo 'CPU details'
                lscpu
             '''
            }
        }
       stage('Memory details') {
            steps {
              sh '''
                echo 'Memory details'
                free -h
             '''
            }
    
        }
      stage('running process details') {
            steps {
               sh '''
                echo 'process details'
                ps -ef
              ''' 
            }
        }   
   }
}  
