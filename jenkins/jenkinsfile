pipeline {
    agent none 
    
    stages {
        stage('Slave 1 Tasks') {
            agent { label 'slave-1' }
            stages {
                stage('Build') {
                    steps {
                        sh 'uptime'
                        sh 'date'
                    }
                }
                stage('Memory utilization by files') {
                    steps {
                        sh 'df -kh'
                        sh 'du -h --max-depth=1'
                    }
                }
                stage('CPU details') {
                    steps {
                        sh 'lscpu'
                    }
                }
                stage('Memory details') {
                    steps {
                        sh 'free -h'
                    }
                }
                stage('Running process details') {
                    steps {
                        sh 'ps -ef'
                    }
                }
            }
        }
        
        stage('Slave 2 Tasks') {
            agent { label 'slave-2' }
            stages {
                stage('Get the hostname') {
                    steps {
                        sh 'hostname -I'
                    }
                }
            }
        }
    }
}
